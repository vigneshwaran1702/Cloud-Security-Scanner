# ==========================================
# Node.js & Dependency Ignore Rules
# ==========================================
node_modules/
*/node_modules/
**/node_modules/
.pnpm-store/
.npm/
.node_repl_history
*.node
.cache/
.vite/
**/dist/
dist/
dist-ssr/
build/
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache

# Node Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/

# Storage & Upload Sandboxes
storage/
backend/app/storage/imports/*
!backend/app/storage/imports/.gitkeep

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
